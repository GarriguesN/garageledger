# GarageLedger environment variables.
# Copy to .env and fill in. Never commit .env.

# --- Required: database ---
DB_PATH=/opt/garageledger/data/garageledger.db

# --- Required: uploads directory (attachments) ---
UPLOAD_DIR=/opt/garageledger/data/uploads

# --- Required: 32+ random chars (e.g. `openssl rand -hex 32`) ---
SESSION_SECRET=replace-with-32+-chars-of-random-data

# --- Required for backups: destination directory ---
# Must exist or be creatable by the user running backups (cron).
BACKUP_DIR=/var/backups/garageledger

# --- Optional: backup retention window in days (default 30) ---
# Backups older than this are pruned on each successful backup run.
BACKUP_RETENTION_DAYS=30

# --- Optional: trust the proxy's client-IP header (default: off) ---
# Ponlo a 1 SOLO si la app está detrás de un proxy inverso que reescribe
# `x-real-ip` (nuestro nginx de CT 105 lo hace). El rate limit del PIN cuenta
# los intentos por IP y la lee de ahí.
#
# Si la app se expone directa a la red, déjalo apagado: la cabecera la
# escribiría el propio cliente, y rotándola se estrenaría bucket en cada
# intento, dejando el limitador en nada. Apagado, todos los clientes comparten
# cubo — menos cómodo, pero un límite real.
TRUST_PROXY_HEADERS=1
